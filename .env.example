# Copy to .env and fill in. Never commit real secrets.
#
# EXPO_PUBLIC_* values are embedded in the app binary — treat them as public.
# Use rate-limited Groq/OCR keys. Never put APPWRITE_API_KEY here.

EXPO_PUBLIC_GROQ_API_KEY=
EXPO_PUBLIC_OCR_SPACE_KEY=
EXPO_PUBLIC_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
EXPO_PUBLIC_APPWRITE_PROJECT_ID=
EXPO_PUBLIC_APPWRITE_DATABASE_ID=medrem_db

# Server / import scripts only (never ship in the app binary)
APPWRITE_API_KEY=
APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_DATABASE_ID=medrem_db
APPWRITE_DOCTORS_COLLECTION=doctors
