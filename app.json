{
  "expo": {
    "name": "MedRem",
    "icon": "./assets/images/logo.png",
    "slug": "my-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.medication-reminder.med-rem",
      "infoPlist": {
        "UIBackgroundModes": ["fetch", "remote-notification"],
        "NSCameraUsageDescription": "MedRem needs camera access to scan medicine labels.",
        "NSPhotoLibraryUsageDescription": "MedRem needs photo access to read medicine labels from your gallery.",
        "NSFaceIDUsageDescription": "MedRem uses Face ID to lock medication data on this device.",
        "UNNotificationCategory": [
          {
            "identifier": "med-reminders-category",
            "actions": [
              {
                "identifier": "SNOOZE",
                "title": "Snooze",
                "options": ["foreground"]
              },
              {
                "identifier": "TAKEN",
                "title": "Taken",
                "options": ["foreground"]
              }
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.medication-reminder.med-rem",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#1B3A5C"
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "SCHEDULE_EXACT_ALARM",
        "POST_NOTIFICATIONS",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/images/logo.png",
          "color": "#1E3A5F",
          "defaultChannel": "med-reminders"
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow MedRem to use your camera to scan medicine labels.",
          "photosPermission": "Allow MedRem to access your photos to scan medicine labels."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow MedRem to use Face ID / biometrics to unlock the app."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "5ce120c5-eb3c-48ea-8541-4854e2080bd8"
      }
    }
  }
}
